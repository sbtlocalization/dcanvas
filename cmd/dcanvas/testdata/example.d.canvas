	"nodes":[
		{
			"id":"n-greet",
			"type":"text",
			"x":0,
			"y":0,
			"width":420,
			"height":200,
			"color":"3",
			"text":"Why do you disturb my grove, mortal?",
			"x-id":"n-greet",
			"x-kind":"line",
			"x-role":"state",
			"x-character":{"name":"Abela the Nymph","portrait":"None.png","gender":"female"}
		},
		{"id":"n-seek","type":"text","x":40,"y":400,"width":340,"height":120,"color":"4","text":"I seek the captive nymph Ragefast holds.","x-id":"n-seek","x-kind":"reply","x-role":"transition"},
		{"id":"n-pass","type":"text","x":520,"y":400,"width":340,"height":120,"color":"4","text":"Just passing through. Forgive me.","x-id":"n-pass","x-kind":"reply","x-role":"transition"},
		{
			"id":"n-reveal",
			"type":"text",
			"x":0,
			"y":720,
			"width":420,
			"height":200,
			"color":"3",
			"text":"Ah — his prisoner. I am she. Will you help me, or gawk like the rest?",
			"x-id":"n-reveal",
			"x-kind":"line",
			"x-role":"state",
			"x-character":{"name":"Abela the Nymph","portrait":"None.png","gender":"female"}
		},
		{"id":"n-free","type":"text","x":40,"y":1120,"width":340,"height":120,"color":"4","text":"Let me free you.","x-id":"n-free","x-kind":"reply","x-role":"transition"},
		{"id":"n-leave","type":"text","x":520,"y":1120,"width":340,"height":120,"color":"4","text":"This is no business of mine.","x-id":"n-leave","x-kind":"reply","x-role":"transition"},
		{
			"id":"n-thanks",
			"type":"text",
			"x":0,
			"y":1440,
			"width":420,
			"height":200,
			"color":"3",
			"text":"Be free, then. The grove remembers a kindness.",
			"x-id":"n-thanks",
			"x-kind":"line",
			"x-role":"state",
			"x-character":{"name":"Abela the Nymph","portrait":"None.png","gender":"female"}
		},
		{
			"id":"n-scorn",
			"type":"text",
			"x":480,
			"y":1440,
			"width":420,
			"height":200,
			"color":"3",
			"text":"Then begone, and trouble me no further.",
			"x-id":"n-scorn",
			"x-kind":"line",
			"x-role":"state",
			"x-character":{"name":"Abela the Nymph","portrait":"None.png","gender":"female"}
		}
	],
