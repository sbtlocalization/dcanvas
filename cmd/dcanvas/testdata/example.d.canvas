{
	"d-version": "1.0",
	"nodes":[
		{
			"id":"n-greet",
			"type":"text",
			"x":0,
			"y":0,
			"width":420,
			"height":200,
			"color":"3",
			"text":"Why do you disturb my grove, mortal?",
			"d-id":"n-greet",
			"d-kind":"line",
			"d-role":"state",
			"d-character":{"name":"Abela the Nymph","portrait":"None.png","gender":"female"}
		},
		{"id":"n-seek","type":"text","x":40,"y":400,"width":340,"height":120,"color":"4","text":"I seek the captive nymph Ragefast holds.","d-id":"n-seek","d-kind":"reply","d-role":"transition"},
		{"id":"n-pass","type":"text","x":520,"y":400,"width":340,"height":120,"color":"4","text":"Just passing through. Forgive me.","d-id":"n-pass","d-kind":"reply","d-role":"transition"},
		{
			"id":"n-reveal",
			"type":"text",
			"x":0,
			"y":720,
			"width":420,
			"height":200,
			"color":"3",
			"text":"Ah — his prisoner. I am she. Will you help me, or gawk like the rest?",
			"d-id":"n-reveal",
			"d-kind":"line",
			"d-role":"state",
			"d-character":{"name":"Abela the Nymph","portrait":"None.png","gender":"female"}
		},
		{"id":"n-free","type":"text","x":40,"y":1120,"width":340,"height":120,"color":"4","text":"Let me free you.","d-id":"n-free","d-kind":"reply","d-role":"transition"},
		{"id":"n-leave","type":"text","x":520,"y":1120,"width":340,"height":120,"color":"4","text":"This is no business of mine.","d-id":"n-leave","d-kind":"reply","d-role":"transition"},
		{
			"id":"n-thanks",
			"type":"text",
			"x":0,
			"y":1440,
			"width":420,
			"height":200,
			"color":"3",
			"text":"Be free, then. The grove remembers a kindness.",
			"d-id":"n-thanks",
			"d-kind":"line",
			"d-role":"state",
			"d-character":{"name":"Abela the Nymph","portrait":"None.png","gender":"female"}
		},
		{
			"id":"n-scorn",
			"type":"text",
			"x":480,
			"y":1440,
			"width":420,
			"height":200,
			"color":"3",
			"text":"Then begone, and trouble me no further.",
			"d-id":"n-scorn",
			"d-kind":"line",
			"d-role":"state",
			"d-character":{"name":"Abela the Nymph","portrait":"None.png","gender":"female"}
		}
	],
	"edges":[
		{"id":"e1","fromNode":"n-greet","fromSide":"bottom","toNode":"n-seek","toSide":"top","toEnd":"arrow","label":"I seek the captive nymph.","d-id":"e1","d-kind":"normal","d-role":"paraphrase"},
		{"id":"e2","fromNode":"n-greet","fromSide":"bottom","toNode":"n-pass","toSide":"top","toEnd":"arrow","label":"Just passing through.","d-id":"e2","d-kind":"normal","d-role":"paraphrase"},
